# Copy to .env and fill in. Names only here - never commit real values.

# Optional: the songaday-display catalog (its publish/meta folder of index-*.json chunks), used
# to cross-check the spreadsheet. Defaults to ~/Library/Caches/songaday-display/publish/meta.
# SONGADAY_CATALOG_DIR=

# Optional: a YouTube Data API v3 key, for current view counts. Without it the views come
# from the last snapshot.
# YOUTUBE_API_KEY=
